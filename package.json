{
  "name": "bi-lens",
  "version": "0.3.1",
  "description": "Analisa imagens do Bilhete de Identidade angolano: classifica, extrai, valida e pontua (com aprovação manual configurável).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LucasSantiagoMartins/bi-lens.git"
  },
  "homepage": "https://github.com/LucasSantiagoMartins/bi-lens#readme",
  "bugs": {
    "url": "https://github.com/LucasSantiagoMartins/bi-lens/issues"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./text": {
      "types": "./dist/text.d.ts",
      "import": "./dist/text.js",
      "require": "./dist/text.cjs"
    }
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "analyse": "node scripts/analyse.mjs"
  },
  "dependencies": {
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
